# Public site URL used for canonical, share-image and sitemap URLs.
VITE_SITE_URL=https://gamerie.gg
# Leave unset on previews. Set to true only on the production deployment.
VITE_SITE_INDEXABLE=
# Consent and analytics load only when set; there are no defaults.
# Enzuzo (cookie banner): the website banner is 62a40aa4-63f3-11f1-88da-6354ce119655 (Enzuzo > Cookie banner > install code).
# GTM-T8ZFFH23 is the Tag Manager container. Leave the GA ID empty when GA runs inside that container;
# it's ignored whenever a GTM ID is set, so views are never counted twice.
VITE_ENZUZO_ID=
VITE_GTM_ID=
VITE_GA_MEASUREMENT_ID=
