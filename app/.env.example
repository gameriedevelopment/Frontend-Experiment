# In local development the dev server proxies /api to backend-two, so no CORS changes are needed.
# In production builds, set VITE_API_URL to the full API URL.
VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_WEBSITE_URL=http://localhost:5178
# Screens not rebuilt here yet hand off to the live app.
VITE_LIVE_APP_URL=https://app.gamerie.gg
VITE_TERMS_OF_SERVICE=https://gameriedevelopment.github.io/Terms-of-service/
VITE_PRIVACY_POLICY=https://gameriedevelopment.github.io/Privacy-policy/
# Cloudflare Turnstile on sign-up and email resend. Leave empty locally.
VITE_TURNSTILE_SITE_KEY=
